# Copy to deploy/.env to override local dev defaults. deploy/.env is git-ignored.
# These values are for LOCAL DEVELOPMENT ONLY. Staging/prod secrets live in AWS SSM Parameter Store.

# --- PostgreSQL 16 ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev
POSTGRES_PORT=5432
# Password for every <svc>_owner / <svc>_app / jobs_owner role created by postgres/init (dev only).
# Applied only when the postgres volume is first created; `docker compose down -v` to reset.
HRMS_DB_PASSWORD=hrms_dev

# --- RabbitMQ (vhost: hrms) ---
RABBITMQ_USER=hrms
RABBITMQ_PASSWORD=hrms_dev
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# --- Redis ---
REDIS_PORT=6379

# --- S3-compatible object storage (SeaweedFS, see docs/adr/0002) ---
# Access key / secret are fixed in deploy/seaweedfs/s3.json: hrms / hrms_dev_secret
S3_BUCKET=hrms-files
S3_PORT=8333
S3_MASTER_UI_PORT=9333

# --- Seq (logs; UI on SEQ_UI_PORT, ingestion on SEQ_INGEST_PORT) ---
SEQ_UI_PORT=5341
SEQ_INGEST_PORT=5342

# --- Mailpit (fake SMTP for dev email) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- pgAdmin ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=hrms_dev
PGADMIN_PORT=5050
